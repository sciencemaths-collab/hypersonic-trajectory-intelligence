{
  "schema": "hti.ablation-protocol.v0.8",
  "status": "frozen-before-final-test",
  "scope": "non-sensitive civil aerospace trajectory research",
  "seeds": [101, 211, 307, 401, 503],
  "horizons_seconds": [0.4, 0.5, 0.6],
  "variants": [
    "constant_velocity",
    "filter_direct",
    "physics_only",
    "learned_only",
    "core_hti",
    "core_plus_structural",
    "core_plus_topology",
    "hti_08_combined"
  ],
  "split_policy": {
    "unit": "complete_trajectory_event",
    "train_fraction": 0.70,
    "validation_fraction": 0.15,
    "test_fraction": 0.15,
    "adjacent_windows_may_cross_splits": false
  },
  "fusion_policy": {
    "selection_data": "validation_only",
    "candidate_structural_weights": [0.0, 0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 1.0],
    "selection_metric": "negative_log_likelihood",
    "tie_break": "smaller_structural_weight"
  },
  "bundle_contract": {
    "require_validation_selection_sha256": true,
    "require_reproducible_combined_probabilities": true,
    "require_topology_definition_sha256": true,
    "require_topology_coefficients_sha256": true,
    "require_ordered_cell_ids_per_variant": true,
    "require_cell_partition_sha256": true,
    "require_conformal_calibration_sha256_when_present": true
  },
  "metrics": {
    "top_k": [1, 3, 5],
    "ece_bins": 15,
    "credible_level": 0.95,
    "bootstrap_iterations": 2000,
    "bootstrap_unit": "trajectory_event",
    "report_selective_risk": true
  },
  "claim_gates": {
    "minimum_test_class_coverage": 0.50,
    "minimum_independent_seeds": 5,
    "combined_nll_must_beat_core": true,
    "maximum_ece_regression": 0.02,
    "credible_coverage_interval": [0.93, 0.97],
    "require_event_bootstrap_interval": true,
    "require_external_domain_validation_for_external_readiness_claim": true
  },
  "orientation_policy": {
    "preferred": "observed_nose_rear_or_independent_attitude",
    "velocity_proxy_must_be_labeled": true,
    "proxy_and_observed_results_must_be_reported_separately": true
  },
  "topology_policy": {
    "definitions_frozen_before_test": true,
    "coefficients_frozen_before_test": true,
    "report_probability_mass_changed": true,
    "report_true_path_suppression_failures": true
  },
  "scientific_note": "Passing implementation tests does not establish predictive improvement. Final claims require the frozen event-level comparison and independent validation evidence."
}
